CLIENT_URL=https://portal.gilanfund.ir

# Upload Settings
MAX_FILE_SIZE=10485760
UPLOAD_DIR=/app/uploads

# Session Settings
SESSION_SECRET=your-session-secret-key-here-minimum-32-chars
SESSION_EXPIRY=24h

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=info
LOG_DIR=./logs

# AI Models Configuration (Optional - for advanced users)
# Default models will be used if not specified
AI_DEFAULT_MODEL=claude-3-5-sonnet
AI_TEMPERATURE=0.2
AI_MAX_TOKENS=4000

# Claude AI Advanced Configuration
CLAUDE_MODEL=claude-sonnet-4-20250514
CLAUDE_MAX_TOKENS=8000

# Cache Configuration
ENABLE_CACHE=true
CACHE_TTL=3600

# Security
CORS_ORIGIN=https://portal.gilanfund.ir
ALLOWED_ORIGINS=https://portal.gilanfund.ir

# Feature Flags
ENABLE_AI_ANALYSIS=true
ENABLE_BALE_INTEGRATION=true
ENABLE_SMS_OTP=true
ENABLE_EMAIL_NOTIFICATIONS=true
ENABLE_AI_VARIABLE_DETECTION=true

# Development Settings (Only for development)
DEV_MODE=false
DEBUG=false
MOCK_SERVICES=false
